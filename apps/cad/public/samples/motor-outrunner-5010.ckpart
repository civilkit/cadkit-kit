 "seq": 323,
 "rollback": null,
 "variables": [
  {
   "name": "SIZE",
   "expr": "5010"
  },
  {
   "name": "EXPLODE",
   "expr": "0"
  },
  {
   "name": "CLR",
   "expr": "0.1"
  },
  {
   "name": "SCREWS",
   "expr": "0"
  },
  {
   "name": "EXTERIOR",
   "expr": "0"
  },
  {
   "name": "BLACK",
   "expr": "0"
  },
