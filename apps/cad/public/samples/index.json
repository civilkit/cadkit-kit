 {
  "id": "pet-bottle",
  "title": "PET bottle 500 ml",
  "file": "pet-bottle.ckpart",
  "detail": "PET bottle 500 ml: a 500 ml PET water bottle with a soft, rounded petaloid base and a screw cap (separate body). The outline with its spline shoulder is revolved and shelled to a 0.35 mm tube; the base is two lofts (the outer solid and the cavity one wall inside it) through 14 round sections, each a closed loop of tangent arcs: five fat feet joined by five small valley ribs, curling under like the 9 mm base corner and running out vertical into the cylinder, with a rounded push-up centre. No fillet is used and no edge of the base is sharp. CAP=1 adds the cap and THREAD=1 gives the neck a real helical thread (28 mm finish: 25.5 mm root, 27.6 mm crest, 2.7 mm pitch, 2 turns, swept on a helix) and the cap the matching internal thread with 0.15 mm flank clearance, plus 30 grip ribs (GRIP). Variables: WALL, FEET (3 to 7), CAP, THREAD, PITCH, TURNS, CLR, GRIP; THREAD=0 keeps the light plain neck and cap",
  "category": "consumer-products",
  "tags": [
   "bottle",
   "container",
   "helix",
   "loft",
   "sweep"
  ]
 },
 {
  "id": "pet-bottle-curved",
  "title": "PET bottle, curved petals",
  "file": "pet-bottle-curved.ckpart",
  "detail": "PET bottle, curved petals: the same 500 ml bottle with the five base grooves swept along 3D splines instead of cut as straight lens shapes. Each groove is a round tube (a circle swept along a sketch3d spline, kept as its own body) that starts in the push-up cone, runs out under the standing ring, curves round the base corner and up the side wall and fades out in the wall; the cavity is cut by the same paths 0.35 mm wider, so the wall stays 0.35 mm thick all round. Variables: WALL, FEET, GROOVE_R (groove radius), SWIRL (degrees the grooves twist round the bottle on the way up), CAP",
  "category": "consumer-products",
  "tags": [
   "bottle",
   "container",
   "sweep",
   "revolve",
   "parametric"
  ]
 },
 {
  "id": "tapered-disc",
  "title": "Tapered spinning disc",
  "file": "tapered-disc.ckpart",
  "detail": "Tapered spinning disc: a flat disc (Y up) that slopes up from a thin edge to a low cone pointing up at the centre, with 12 smooth ridges running straight from the centre out to a plain circular edge that rises and falls round the rim, so a ball rolling off it drops into a tube. One lofted body through wave-shaped spline sections (no seams, nothing added on top), trimmed by a cylinder. Variables: N (number of ridges, 12), K (ridge depth, 0.28), R (disc radius, 60), T0 (minimum edge thickness, 3), POCKET (1 hollows the underside with a round recess for a lighter print), SKIN (material left above the recess, 2), RIM (flat ring left at the edge, 8)",
  "category": "printing",
  "tags": [
   "printable",
   "loft",
   "parametric"
  ]
 },
