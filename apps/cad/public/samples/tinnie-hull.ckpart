 ],
 "seq": 61,
 "rollback": null,
 "script": "const st = [[0,750,600,0],[600,750,600,0],[1200,745,595,0],[1800,700,540,0],[2400,560,390,40],[3000,330,190,110],[3500,60,20,260]];\nconst H = 450, T = 3, X = 20;\nconst outer = st.map(([x, wt, wb, yb]) => ({ on: at('right', x), draw: (s) => s.polygon([[-wb, yb], [wb, yb], [wt, H], [-wt, H]]) }));\n// inner cavity: every wall moved in by T, top extended X above the gunwale along the same flare\nconst inner = st.map(([x, wt, wb, yb], i) => {\n  const ix = i === 0 ? T : (i === st.length - 1 ? x - T : x);\n  const k = (wt - wb) / (H - yb);\n  const ib = wb - T, it = wt - T + k * X, yt = H + X, yy = yb + T;\n  return { on: at('right', ix), draw: (s) => s.polygon([[-ib, yy], [ib, yy], [it, yt], [-it, yt]]) };\n});\nlet h = part('Tinnie hull').loft(outer, {}).loft(inner, { op: 'cut' });\nconst half = (x, y) => { let k = 0; while (k < st.length - 2 && x > st[k + 1][0]) k++; const a = st[k], b = st[k + 1], f = (x - a[0]) / (b[0] - a[0]);\n  const g = (r) => r[2] + (r[1] - r[2]) * (y - r[3]) / (H - r[3]); return g(a) + (g(b) - g(a)) * f; };\n// middle bench seat: short slabs, each as wide as the hull skin there (mid-wall), so the seat fuses to the walls without poking through\nfor (let x0 = 1500; x0 < 1800; x0 += 30) {\n  const w = Math.min(half(x0, 250), half(x0 + 30, 250)) - 2.8;\n  h = h.sketch(at('right', x0), (s) => s.rect(2 * w, 40, [0, 270])).extrude(30);\n}\n"
}