 "seq": 78,
 "rollback": null,
 "script": "const HANDLE = {\"format\":\"ck-part\",\"version\":1,\"name\":\"Grab handle\",\"features\":[{\"type\":\"plane\",\"id\":\"F1\",\"mode\":\"offset\",\"base\":{\"kind\":\"std\",\"id\":\"right\"},\"offset\":0},{\"type\":\"sketch\",\"id\":\"F2\",\"plane\":{\"kind\":\"feature\",\"id\":\"F1\"},\"points\":[{\"id\":\"O\",\"x\":0,\"y\":0,\"fixed\":true},{\"id\":\"p1\",\"x\":20,\"y\":0}],\"entities\":[{\"id\":\"e1\",\"type\":\"circle\",\"c\":\"p1\",\"r\":4}],\"constraints\":[]},{\"type\":\"plane\",\"id\":\"F3\",\"mode\":\"offset\",\"base\":{\"kind\":\"std\",\"id\":\"top\"},\"offset\":0},{\"type\":\"sketch\",\"id\":\"F4\",\"plane\":{\"kind\":\"feature\",\"id\":\"F3\"},\"points\":[{\"id\":\"O\",\"x\":0,\"y\":0,\"fixed\":true},{\"id\":\"p1\",\"x\":0,\"y\":20},{\"id\":\"p2\",\"x\":-45,\"y\":20},{\"id\":\"p3\",\"x\":-45,\"y\":-20},{\"id\":\"p4\",\"x\":0,\"y\":-20}],\"entities\":[{\"id\":\"e1\",\"type\":\"line\",\"p1\":\"p1\",\"p2\":\"p2\"},{\"id\":\"e2\",\"type\":\"line\",\"p1\":\"p2\",\"p2\":\"p3\"},{\"id\":\"e3\",\"type\":\"line\",\"p1\":\"p3\",\"p2\":\"p4\"}],\"constraints\":[]},{\"type\":\"sweep\",\"id\":\"F5\",\"op\":\"add\",\"sketch\":\"F2\",\"path\":{\"kind\":\"sketch\",\"id\":\"F4\"}}],\"seq\":6,\"rollback\":null,\"script\":\"// Transom grab handle: 8 mm round bar bent into a flat U loop, 45 mm out and 40 mm wide, lying in the XZ plane (local origin = centre of the open side).\\npart('Grab handle').sweep(\\n  { on: at('right', 0), draw: (s) => s.circle(4, [20, 0]) },\\n  { on: at('top', 0), draw: (s) => s.polyline([[0, 20], [-45, 20], [-45, -20], [0, -20]]) });\\n\"};\n// Tinnie: 3.53 m x 1.45 m aluminium boat, 1.6 mm sheet. X = length (0 stern transom .. 3530 bow tip), Y up, Z across. mm.\nconst H = 450, T = 1.6;\nconst st = [[0,725,590,0],[500,725,590,0],[1000,724,588,0],[1500,712,560,0],[1900,690,520,0],[2200,650,450,12],[2500,590,380,40],[2800,510,290,85],[3100,400,170,145],[3350,250,80,225],[3530,8,2,330]];\nconst outer = st.map(([x, wt, wb, yb]) => ({ on: at('right', x), draw: (s) => s.polygon([[-wb, yb], [wb, yb], [wt, H], [-wt, H]]) }));\n// outer half width of the hull at height y, station x (piecewise linear through the stations)\nconst half = (x, y) => { let k = 0; while (k < st.length - 2 && x > st[k + 1][0]) k++; const a = st[k], b = st[k + 1], f = (x - a[0]) / (b[0] - a[0]);\n  const g = (r) => r[2] + (r[1] - r[2]) * (y - r[3]) / (H - r[3]); return g(a) + (g(b) - g(a)) * f; };\nconst hw = (x, y) => half(x, y) - 1.0;      // 1.0 mm inside the outer skin: fuses into the 1.6 mm wall, never pokes through\nconst floorY = (x) => { let k = 0; while (k < st.length - 2 && x > st[k + 1][0]) k++; const a = st[k], b = st[k + 1]; return a[3] + (b[3] - a[3]) * (x - a[0]) / (b[0] - a[0]); };\nconst P = part('Tinnie boat');\n// 1) hull: 11 stations lofted (flat bottom, flared sides, bow rise), one-step shell of the open top\nP.loft(outer, {}); const hullH = P.handle(); P.shell(face('>Y'), T);\n// 2) closed triangular bow deck at y=380, 2 mm plate\n{ const xs = [2950, 3050, 3150, 3250, 3350, 3450, 3515]; const pts = [];\n  xs.forEach((x) => pts.push([x, -hw(x, 380)])); pts.push([3528, 0]); xs.slice().reverse().forEach((x) => pts.push([x, hw(x, 380)]));\n  P.sketch(at('top', 380), (s) => s.polygon(pts)).extrude(2); }\n// 4a) floor ribs: ONE seed bar (side-view profile extruded across Z) + one linear pattern of 14\nP.sketch(at('front', -462), (s) => s.polygon([[60, 0.3], [1760, 0.3], [1760, 8.3], [60, 8.3]])).extrude(14);\nP.linearPattern({ count: 14, spacing: 70, direction: 'z' });\n// 4b) bow floor ribs follow the rising floor (4 ribs)\n{ const xs = [1700, 1900, 2200, 2500, 2800, 2900]; const lo = xs.map((x) => [x, floorY(x) + 0.3]); const hi = lo.slice().reverse().map(([x, y]) => [x, y + 8]);\n  P.sketch(at('front', -112), (s) => s.polygon([...lo, ...hi])).extrude(14);\n  P.linearPattern({ count: 4, spacing: 70, direction: 'z' }); }\n// 4c) centreline keel strip\nP.sketch(at('front', -18), (s) => s.polygon([[60, 0.3], [1760, 0.3], [1760, 13], [60, 13]])).extrude(36);\n// 4d) chevron cross ribs (V pointing to the bow): 3 in the middle + 1 near the transom, one sketch, one extrude\n{ const chev = (xc) => { const e1 = hw(xc - 105, 0.6) - 2, e = Math.min(e1, 586); return [[xc - 120, -e], [xc, 0], [xc - 120, e], [xc - 90, e], [xc + 30, 0], [xc - 90, -e]]; };\n  P.sketch(at('top', 0.6), (s) => { [250, 1050, 1400, 1750].forEach((xc) => s.polygon(chev(xc))); }).extrude(22); }\n// 4e) side frames on the inside of both walls, one sketch, one pattern (parallel-sided aft part only)\nP.sketch(at('right', 100), (s) => {\n  [1, -1].forEach((sg) => s.polygon([[-sg * hw(100, 20), 20], [-sg * hw(100, 440), 440], [-sg * (hw(100, 440) - 10), 440], [-sg * (hw(100, 20) - 10), 20]]));\n}).extrude(14);\nP.linearPattern({ count: 9, spacing: 100, direction: 'x' });\n// 5) benches: tall hollow boxes (two 2 mm bulkheads + 3 mm top) between the hull walls, front one with a hatch box\nconst bench = (x1, x2, hgt) => {\n  [x1, x2 - 2].forEach((x) => { const yb = floorY(x) + 6; P.sketch(at('right', x), (s) => s.polygon([[-hw(x, yb), yb], [hw(x, yb), yb], [hw(x, hgt), hgt], [-hw(x, hgt), hgt]])).extrude(2); });\n  P.sketch(at('top', hgt - 3), (s) => s.polygon([[x1, -hw(x1, hgt)], [x2, -hw(x2, hgt)], [x2, hw(x2, hgt)], [x1, hw(x1, hgt)]])).extrude(4); };\nbench(550, 900, 300);\nbench(2150, 2500, 300);\nP.sketch(at('right', 2130), (s) => s.rect(220, 90, [0, 210])).extrude(22); P.appearance({ face: P.handle(), colour: '#17181a', finish: 'matte' });\n// 6) rear corner gussets: triangular plates, both corners in one sketch\nP.sketch(at('top', 400), (s) => { [1, -1].forEach((sg) => s.polygon([[1, -sg * hw(1, 400)], [1, -sg * (hw(1, 400) - 260)], [260, -sg * hw(260, 400)]])); }).extrude(2);\n// 3) top edge rib: flat rolled rim ring, 12 wide x 8 tall, along the whole top edge (the sweep route fails: see gaps)\n{ const xs = st.map((r) => r[0]); xs[xs.length - 1] = 3525;\n  const o = xs.map((x) => hw(x, 450)); const n = xs.length;\n  P.sketch(at('top', 446), (s) => {\n    s.polygon([[1, -o[0]], ...xs.slice(1).map((x, i) => [x, -o[i + 1]]), [3528, 0], ...xs.slice(1).map((x, i) => [x, o[i + 1]]).reverse(), [1, o[0]]]);\n    const iw = xs.map((x, i) => o[i] - 12);\n    s.polygon([[13, -iw[0]], ...xs.slice(1, n - 1).map((x, i) => [x, -iw[i + 1]]), [3490, 0], ...xs.slice(1, n - 1).map((x, i) => [x, iw[i + 1]]).reverse(), [13, iw[0]]]);\n  }).extrude(8);\n}\n// 8) bow eye: small ring (revolved circle) at the stem\nP.sketch(at('top', 392), (s) => s.circle(3.5, [3550, 0])).revolve(360, { axis: { from: [3540, -20], to: [3540, 20] } });\n// 7) rear handles: ONE separate part (grab-handle.ckpart) inserted twice at the transom corners (mirror of an insertPart fails: see gaps)\nP.insertPart(HANDLE, { at: [0, 395, -640], name: 'Grab handle' }); const h1 = P.handle();\nP.insertPart(HANDLE, { at: [0, 395, 640], name: 'Grab handle' }); const h2 = P.handle();\n// colours: bare aluminium hull and fittings, dark handles\nP.appearance({ feature: hullH, colour: '#cfd4d9', finish: 'matte' });\nP.appearance({ feature: h1, colour: '#2b2e33', finish: 'matte' });\nP.appearance({ feature: h2, colour: '#2b2e33', finish: 'matte' });\n",
