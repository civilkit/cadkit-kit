 ],
 "seq": 22,
 "rollback": null,
 "script": "const st = [[0,750,600,0],[600,750,600,0],[1200,745,595,0],[1800,700,540,0],[2400,560,390,40],[3000,330,190,110],[3500,60,20,260]];\nconst H = 450, T = 3, X = 20;\nconst outer = st.map(([x, wt, wb, yb]) => ({ on: at('right', x), draw: (s) => s.polygon([[-wb, yb], [wb, yb], [wt, H], [-wt, H]]) }));\nconst half = (x, y) => { let k = 0; while (k < st.length - 2 && x > st[k + 1][0]) k++; const a = st[k], b = st[k + 1], f = (x - a[0]) / (b[0] - a[0]);\n  const g = (r) => r[2] + (r[1] - r[2]) * (y - r[3]) / (H - r[3]); return g(a) + (g(b) - g(a)) * f; };\n// the seat: a short tapered plank (loft of two rectangles) as wide as the hull skin at its two ends, inset 2.2 mm so it fuses into the wall without poking through\nconst seat = (x) => ({ on: at('right', x), draw: (s) => { const w = half(x, 250) - 2.2; s.polygon([[-w, 250], [w, 250], [w, 290], [-w, 290]]); } });\npart('Tinnie hull')\n  .loft(outer, {})                    // outer skin through 7 stations\n  .shell(face('>Y'), T)               // open the top, 3 mm walls (one step)\n  .loft([seat(1500), seat(1800)]);    // seat across the boat\n"
}