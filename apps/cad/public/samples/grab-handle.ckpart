 "rollback": null,
 "script": "// Transom grab handle: 8 mm round bar bent into a flat U loop, 45 mm out and 40 mm wide, lying in the XZ plane (local origin = centre of the open side).\npart('Grab handle').sweep(\n  { on: at('right', 0), draw: (s) => s.circle(4, [20, 0]) },\n  { on: at('top', 0), draw: (s) => s.polyline([[0, 20], [-45, 20], [-45, -20], [0, -20]]) });\n"
