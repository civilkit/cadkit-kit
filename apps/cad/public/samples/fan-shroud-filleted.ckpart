 ],
 "seq": 50,
 "rollback": null,
 "script": "// Fan shroud (CAD vs CAD 25-SPO-20). ABS 1020 kg/m3. Second reading: pillar side walls follow the notch curve (1.5 wall).\nconst t4 = Math.tan(4 * Math.PI / 180), t8 = Math.tan(8 * Math.PI / 180);\nconst rOut = (z) => 22 + (33 - z) * t4;\nconst rWall = (z) => rOut(z) - 1.5 / Math.cos(4 * Math.PI / 180);\nconst rIn = (z) => 15 - (33 - z) * t8;\nconst rBowl = (z) => rIn(z) + 1.5;\nconst P = (r, z) => [r, -z];                       // 'top' plane: sketch y = -world z\n\n// fillet drawn as an arc inside a revolve profile: round the corner C between P0 and P1 (all [r, z]) with radius R\nconst round = (P0, C, P1, R, n = 48) => {\n  const nrm = (v) => { const l = Math.hypot(v[0], v[1]); return [v[0] / l, v[1] / l]; };\n  const u0 = nrm([P0[0] - C[0], P0[1] - C[1]]), u1 = nrm([P1[0] - C[0], P1[1] - C[1]]);\n  const phi = Math.acos(u0[0] * u1[0] + u0[1] * u1[1]), d = R / Math.tan(phi / 2);\n  const T0 = [C[0] + u0[0] * d, C[1] + u0[1] * d], T1 = [C[0] + u1[0] * d, C[1] + u1[1] * d];\n  const b = nrm([u0[0] + u1[0], u0[1] + u1[1]]), k = R / Math.sin(phi / 2), O = [C[0] + b[0] * k, C[1] + b[1] * k];\n  let a0 = Math.atan2(T0[1] - O[1], T0[0] - O[0]), a1 = Math.atan2(T1[1] - O[1], T1[0] - O[0]);\n  let da = a1 - a0; while (da > Math.PI) da -= 2 * Math.PI; while (da < -Math.PI) da += 2 * Math.PI;\n  return Array.from({ length: n + 1 }, (_, i) => [O[0] + R * Math.cos(a0 + da * i / n), O[1] + R * Math.sin(a0 + da * i / n)]);\n};\nconst rt = (pts) => pts.map(([r, z]) => P(r, z));\n\n// notch outline in the front view (x, z): left edge a straight 4 deg line, right edge an R42 arc, 10 wide at z = 33, 25 deep\nconst bot = [-5 + 25 * t4, 8], tp = [5, 33];\nconst arc = (() => {\n  const L = Math.hypot(tp[0] - bot[0], tp[1] - bot[1]), u = [(tp[0] - bot[0]) / L, (tp[1] - bot[1]) / L];\n  let n = [-u[1], u[0]]; if (n[0] > 0) n = [-n[0], -n[1]];\n  const d = Math.sqrt(42 * 42 - (L / 2) ** 2), m = [(tp[0] + bot[0]) / 2, (tp[1] + bot[1]) / 2], c = [m[0] + n[0] * d, m[1] + n[1] * d];\n  const a0 = Math.atan2(bot[1] - c[1], bot[0] - c[0]), a1 = Math.atan2(tp[1] - c[1], tp[0] - c[0]);\n  return Array.from({ length: 17 }, (_, i) => { const a = a0 + (a1 - a0) * i / 16; return [c[0] + 42 * Math.cos(a), c[1] + 42 * Math.sin(a)]; });\n})();\nconst W = 1.5;                                      // pillar side wall beside the notch\n\n// x of the notch edges at height z (left: 4 deg line, right: the R42 arc), grown by W for the pillar walls\nconst xl = (z) => (z >= 8 ? -5 + (33 - z) * t4 : bot[0]) - W;\nconst xr = (z) => {\n  if (z <= 8) return bot[0] + W;\n  for (let i = 1; i < arc.length; i++) if (arc[i][1] >= z) { const [x0, z0] = arc[i - 1], [x1, z1] = arc[i]; return x0 + (x1 - x0) * (z - z0) / (z1 - z0) + W; }\n  return tp[0] + W;\n};\nconst band = (z0, z1) => { const zs = Array.from({ length: 9 }, (_, i) => z0 + (z1 - z0) * i / 8);\n  return [...zs.map((z) => [xl(z), -z]), ...zs.slice().reverse().map((z) => [xr(z), -z])]; };\n\nconst p = part('Fan shroud');\np.sketch('front', (s) => s.rect(55, 55)).extrude(3).fillet(edges('|Z'), 6)\n  .holes.points(face('>Z'), [[-21.75, -21.75], [21.75, -21.75], [-21.75, 21.75], [21.75, 21.75]],\n    { kind: 'cbore', diameter: 3.1, cboreDiameter: 7, cboreDepth: 1 });\n// gap through the plate between bowl and outer wall (its edges sit inside the walls added later: no coincident faces)\np.sketch('top', (s) => s.polygon([P(rBowl(-1) - 3.6, -1), P(rWall(-1) + 0.75, -1), P(rWall(34) + 0.75, 34), P(rBowl(34) - 3.6, 34)])).revolve(360, { op: 'cut' });\n// bowl body\np.sketch('top', (s) => s.polygon([P(0, 0), ...rt(round([0, 0], [rBowl(0), 0], [rBowl(33), 33], 3)), P(rBowl(33), 33), P(0, 33)])).revolve(360);\n// pillar side walls: the notch outline grown by W, in thin height bands whose flat outer ends (corners included) stay inside the outer wall,\n// +Y and -Y sides, then patterned 90 deg. Band edges are chosen by walking up: the end must reach the wall's inner face at the band's foot and its\n// widest corner must stay inside the cone surface at the band's head.\nconst hs = [];\nconst xmaxOf = (z0, z1) => { let m = 0; for (let i = 0; i <= 8; i++) { const z = z0 + (z1 - z0) * i / 8; m = Math.max(m, Math.abs(xl(z)), Math.abs(xr(z))); } return m; };\nconst yEnd = (z0, z1) => Math.sqrt((rOut(z1) - 0.1) ** 2 - xmaxOf(z0, z1) ** 2);\nfor (let z0 = 0; z0 < 33 - 1e-9;) {\n  let z1 = Math.min(33, z0 + 0.5);\n  while (z1 < 33 && yEnd(z0, Math.min(33, z1 + 0.5)) >= rWall(z0) + 0.1) z1 = Math.min(33, z1 + 0.5);\n  const y1 = yEnd(z0, z1);\n  p.sketch(at('top', 8), (s) => s.polygon(band(z0, z1))).extrude(y1 - 8); hs.push(p.handle());\n  p.sketch(at('top', -y1), (s) => s.polygon(band(z0, z1))).extrude(y1 - 8); hs.push(p.handle());\n  z0 = z1;\n}\np.circularPattern(hs, { count: 2, axis: 'z', angle: 90, equalSpacing: false });\n// outer wall (4 deg draft, 1.5 thick, 44 across the top)\n{ const C = [rOut(3), 3], foot = round([rOut(3) + 2.9, 3], C, [22, 33], 3);   // concave fillet where the cone meets the plate\n  p.sketch('top', (s) => s.polygon([P(rWall(0), 0), P(foot[0][0], 0), ...rt(foot), P(22, 33), P(rWall(33), 33)])).revolve(360); }\n// bowl cavity (floor 1.5)\np.sketch('top', (s) => s.polygon([P(0, 1.5), ...rt(round([0, 1.5], [rIn(1.5), 1.5], [rIn(34), 34], 1.5)), P(rIn(34), 34), P(0, 34)])).revolve(360, { op: 'cut' });\n// the notch: through the part, 2 copies 90 deg apart = 4 notches\np.sketch('top', (s) => s.polygon([[-5 - t4, -34], [bot[0], -bot[1]], ...arc.slice(1).map(([x, z]) => [x, -z]), [tp[0], -34]])).cut(through(), { mid: true });\np.circularPattern({ count: 2, axis: 'z', angle: 90, equalSpacing: false });\np.fillet(edges({ near:[-4.13,12.58,20.5], within:1 }), 2);\np.fillet(edges({ near:[-4.13,22.5,20.5], within:1 }), 0.5);\n"
}