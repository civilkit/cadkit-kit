{
  "id": "./",
  "name": "CivilKit CAD",
  "short_name": "CivilKit",
  "description": "Parametric CAD in the browser",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#131b25",
  "theme_color": "#131b25",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/hero.png", "sizes": "960x540", "type": "image/png", "form_factor": "wide", "label": "A part open in CivilKit CAD" },
    { "src": "screenshots/editor-loft.png", "sizes": "1500x950", "type": "image/png", "form_factor": "wide", "label": "Editing a loft with the feature tree" }
  ],
  "file_handlers": [
    { "action": "./", "name": "CivilKit part", "accept": { "application/x-civilkit-part": [".ckpart"] } }
  ]
}
