{
  "name": "kit",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite apps/cad --config vite.config.ts",
    "build:pages": "node tools/build_pages.mjs",
    "stack:status": "node tools/stack_status.mjs",
    "build": "vite build apps/cad --config vite.config.ts",
    "test": "vitest run",
    "test:kernel": "CK_TEST_WORKERS=1 vitest run .kernel.test",
    "pages:leakcheck": "node tools/pages_leakcheck.mjs dist-pages",
    "skill:generate": "node packages/skill/tools/generate.mjs",
    "ux:shots": "node tools/ux/shots.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:check": "node tools/i18n_check.mjs",
    "samples:thumbs:check": "node tools/library_thumbs.mjs apps/cad/public/samples --check",
    "i18n:baseline": "node tools/i18n_check.mjs --update-baseline",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@preact/signals": "^1.3.0",
    "@preact/signals-core": "^1.8.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "jsdom": "^25.0.0",
    "preact": "^10.24.0",
    "three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
