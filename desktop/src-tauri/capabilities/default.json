{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The CivilKit CAD window: open links in the browser, and write a file the user chose in a Save dialog.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
