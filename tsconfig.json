{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vite/client"],
    "paths": {
      "@kit/*": ["./packages/*/src/index.ts"],
      "@ck/driver-verify": ["../rebuild/packages/driver/src/verify.ts"],
      "@ck/session": ["../rebuild/packages/session/src/session.ts"],
      "@ck/mesh": ["../rebuild/packages/render/src/mesh.ts"],
      "@ck/part-model": ["../rebuild/packages/part-model/src/index.ts"],
      "@ck/kernel-client/browser": ["../rebuild/packages/kernel-client/src/browser.ts"],
      "@ck/kernel-client/node": ["../rebuild/packages/kernel-client/src/worker.ts"],
      "@ck/kernel-client/native": ["../rebuild/packages/kernel-client/src/native.ts"],
      "@ck/kernel-client/mock": ["../rebuild/packages/kernel-client/src/mock-service.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"]
}